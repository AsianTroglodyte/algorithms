    {
      "id": "pr8ZAQUONcFfJbMujTjCp",
      "type": "text",
      "x": 1494.6019835963084,
      "y": -5899.805708039192,
      "width": 390.625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0CP",
      "roundness": null,
      "seed": 1397122400,
      "version": 58,
      "versionNonce": 1216219296,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789770657097,
      "created": 1789770134871,
      "link": null,
      "locked": false,
      "text": "it is a Binary Search Tree\n\nit has other properties as well:\n 1. A node is either red of black.\n 2. the root is black\n 3. leaves (NIL) are black.\n 4. If a node is red, then its children are black.\n    invariant 5 is the key invariant\n 5. All paths from a node to its NIL descendants \n    contain the same number of black nodes.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "it is a Binary Search Tree\n\nit has other properties as well:\n 1. A node is either red of black.\n 2. the root is black\n 3. leaves (NIL) are black.\n 4. If a node is red, then its children are black.\n    invariant 5 is the key invariant\n 5. All paths from a node to its NIL descendants \n    contain the same number of black nodes.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "UOoB1OtkxeWYfmQh1sr3z",
