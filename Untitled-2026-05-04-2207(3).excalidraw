    {
      "id": "17cxWR8ac-cHuWfy2FErp",
      "type": "text",
      "x": 7725.263560806033,
      "y": 243.6405562533243,
      "width": 387.125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
