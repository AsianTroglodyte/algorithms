      "seed": 1693298848,
      "version": 287,
      "versionNonce": 1540120736,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789770657097,
      "created": 1789770151570,
      "link": null,
      "locked": false,
      "text": "which one of these are a valid binary search tree?\nwhat properties does the wrong ones violate?\n\nkeep track of black height (bh) black height is *very*\nimportant",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
