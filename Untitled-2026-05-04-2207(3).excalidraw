      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "iYtBohDwnxyUZ8gESt-tm",
      "type": "text",
      "x": 5605.534241678919,
      "y": -557.5731266213782,
      "width": 717.3499755859375,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c02X",
      "roundness": null,
      "seed": 2025235808,
      "version": 522,
      "versionNonce": 447843488,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789704846300,
      "created": 1789702290370,
      "link": null,
      "locked": false,
      "text": "It is a pointer structure change. \n\nIt is a local operation in a BST that preserves\nordering, the binary-search-tree property\n\nIt is a powerful fundamental operation for balancing\nmost binary search trees",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is a pointer structure change. \n\nIt is a local operation in a BST that preserves\nordering, the binary-search-tree property\n\nIt is a powerful fundamental operation for balancing\nmost binary search trees",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
