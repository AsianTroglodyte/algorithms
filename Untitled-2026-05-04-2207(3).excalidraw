      "type": "text",
      "x": 801.6081962718428,
      "y": -6008.672681417636,
      "width": 522.3499755859375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
