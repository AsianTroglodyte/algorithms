      "link": null,
      "locked": false,
      "text": "node 2 is a parent that has left child 1 and\nright child 4. \n\nnode 5 is also a parent with left child 2 and\nright child 10.\n\nNodes without children are called *leaves*",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "node 2 is a parent that has left child 1 and right child 4. \n\nnode 5 is also a parent with left child 2 and right child 10.\n\nNodes without children are called *leaves*",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
