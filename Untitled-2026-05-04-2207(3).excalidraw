      "version": 258,
      "versionNonce": 1895057760,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789706907505,
      "created": 1789587219991,
      "link": null,
      "locked": false,
      "text": "1. transplant\n    - helps us move subtrees within the tree\n2. delete\n    - deletes the node\n3. delete_fixup\n    - fixes any red-black violations",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. transplant\n    - helps us move subtrees within the tree\n2. delete\n    - deletes the node\n3. delete_fixup\n    - fixes any red-black violations",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
