    {
      "id": "M-0jXeCBHzWXUuluU3Pgg",
      "type": "text",
      "x": -276.950961895505,
      "y": -6125.152650410154,
      "width": 296.04998779296875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
