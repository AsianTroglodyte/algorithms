    {
      "id": "ecWcKCdw9Z56k0LyGXnso",
      "type": "text",
      "x": 628.97629923017,
      "y": -8896.082126817277,
      "width": 187.5500030517578,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
