      "version": 423,
      "versionNonce": 119738528,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789702282707,
      "created": 1789699437527,
      "link": null,
      "locked": false,
      "text": "It is a pointer structure change. \n\nIt is a local operation in search tree that preserves\nordering, the binary-search-tree property\n\nIt is a powerful fundamental operation for balancing\nmost binary search trees",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
