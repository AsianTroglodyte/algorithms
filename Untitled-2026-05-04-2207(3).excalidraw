    {
      "id": "vErtXRQKlADE2qyvxXlcB",
      "type": "text",
      "x": 2576.941721579255,
      "y": 16490.06096608952,
      "width": 463.20001220703125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
