    {
      "id": "E1opXcgh5ebcAFT-VFfyj",
      "type": "text",
      "x": 8681.600308732548,
      "y": -118.98532255258817,
      "width": 357.1320811696978,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c03w",
      "roundness": null,
      "seed": 537008480,
      "version": 363,
      "versionNonce": 769523040,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789704911031,
      "created": 1789703093519,
      "link": null,
      "locked": false,
      "text": "The right spine of a tree is the\npath formed by starting at \nthe root and repeatedly following\nright children. ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The right spine of a tree is the path formed by starting at \nthe root and repeatedly following right children. ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "p5RyIS2MHPOqY_mqv4VLW",
      "type": "text",
      "x": 9142.166060165047,
      "y": -105.6608390877418,
      "width": 517.2999877929688,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c03x",
      "roundness": null,
      "seed": 2134371680,
      "version": 307,
      "versionNonce": 804737376,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789704911031,
      "created": 1789703093519,
      "link": null,
      "locked": false,
      "text": "A completely right-leaning tree is a tree whose entire\nset of nodes lies on that spine.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A completely right-leaning tree is a tree whose entire set of nodes lies on that spine.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
