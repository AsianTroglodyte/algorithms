      "boundElements": [],
      "updated": 1789706917214,
      "created": 1789620785069,
      "link": null,
      "locked": false,
      "text": "even more concentrated: 13.1-5,13.2-3,13.2-4,13.3-2,13.3-3,13.4-6",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "even more concentrated: 13.1-5,13.2-3,13.2-4,13.3-2,13.3-3,13.4-6",
      "autoResize": true,
