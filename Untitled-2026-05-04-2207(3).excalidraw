    {
      "id": "GwQXeHYI98spc_SCFFskB",
      "type": "text",
      "x": -926.5348360705419,
      "y": -10037.122903572872,
      "width": 724.2000122070312,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0AT",
      "roundness": null,
      "seed": 1313562976,
      "version": 1306,
      "versionNonce": 2014440608,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789799667143,
      "created": 1789766889000,
      "link": null,
      "locked": false,
      "text": "Suppose we want to insert a node with key 3.\n\nWe must keep the BST property!\n\nWe start at the root and use the BST property \nto search for the position where 3 belongs.\n(no need to be super specific for the question\nbelow)\n\n    - Which direction should we travel at each node?\n    - How do we know when we've found the insertion\n    position?\n    - Once we stop, do we attach the new node on \n    the left or right   \n    - What special case occurs for an empty tree? ",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Suppose we want to insert a node with key 3.\n\nWe must keep the BST property!\n\nWe start at the root and use the BST property \nto search for the position where 3 belongs.\n(no need to be super specific for the question\nbelow)\n\n    - Which direction should we travel at each node?\n    - How do we know when we've found the insertion\n    position?\n    - Once we stop, do we attach the new node on \n    the left or right   \n    - What special case occurs for an empty tree? ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
