      "text": "Here we rotate \nnode 10 right ",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here we rotate \nnode 10 right ",
