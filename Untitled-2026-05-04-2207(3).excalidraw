    },
    {
      "id": "sbmUaTdDu9qKG0c5Sz4DJ",
      "type": "text",
      "x": -1414.672108275806,
      "y": -2655.2617657244423,
      "width": 216.5749969482422,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c01c",
      "roundness": null,
      "seed": 2037404000,
      "version": 112,
      "versionNonce": 1655870624,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789700596599,
      "created": 1789700088674,
      "link": null,
      "locked": false,
      "text": "Here we rotate \nnode 5 left",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here we rotate \nnode 5 left",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "u9BrdjYKW3V5lf0OH_Qib",
      "type": "text",
      "x": -1545.6526611488937,
      "y": -2562.872180875995,
      "width": 545.4249877929688,
      "height": 490,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c01j",
      "roundness": null,
      "seed": 2072062304,
      "version": 654,
      "versionNonce": 1560091808,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789701154585,
      "created": 1789700253783,
      "link": null,
      "locked": false,
      "text": "Let's look at a left rotation at node 5.\n\nWe call the node we rotate the \nrotate-down node.\n\nTo rotate a node left, it MUST have\na non-NIL right child. We call that\nchild the rotate-up node.\n\nThe rotate-up node's left child may\nbe NIL or the root of a subtree. \n\nIf it is a subtree, that subtree must \nbe transferred during the rotation.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Let's look at a left rotation at node 5.\n\nWe call the node we rotate the \nrotate-down node.\n\nTo rotate a node left, it MUST have\na non-NIL right child. We call that\nchild the rotate-up node.\n\nThe rotate-up node's left child may\nbe NIL or the root of a subtree. \n\nIf it is a subtree, that subtree must \nbe transferred during the rotation.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
