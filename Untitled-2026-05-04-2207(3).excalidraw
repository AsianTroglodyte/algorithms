    {
      "id": "dtwDbyISpB-tOgbOW1iq0",
      "type": "text",
      "x": -1025.8045526137234,
      "y": -5109.111035674376,
      "width": 1129.324951171875,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
