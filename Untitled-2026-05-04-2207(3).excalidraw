      "type": "text",
      "x": 1120.013342382299,
      "y": -2684.3628937320696,
      "width": 572.7750244140625,
      "height": 490,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
