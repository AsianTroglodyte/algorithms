      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "hGj3pxz-dS9aqHjUg3OwG",
      "type": "text",
      "x": -2487.7562196440867,
      "y": 13795.736096273551,
      "width": 426.95001220703125,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDv",
      "roundness": null,
      "seed": 2130856470,
      "version": 829,
      "versionNonce": 1629765792,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789706917213,
      "created": 1789579776480,
      "link": null,
      "locked": false,
      "text": "scenarios to fix up\n1. inserted = root        \n    -> color black\n2. inserted node's uncle = red  \n    -> recolor uncle, parent, and grandparent\n3. inserted node's uncle = black (triangle) \n    -> right rotate parent\n4. inserted node's uncle = black (line) \n    -> left rotate grandparent and recolor \n       parent and grandparent",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "scenarios to fix up\n1. inserted = root        \n    -> color black\n2. inserted node's uncle = red  \n    -> recolor uncle, parent, and grandparent\n3. inserted node's uncle = black (triangle) \n    -> right rotate parent\n4. inserted node's uncle = black (line) \n    -> left rotate grandparent and recolor \n       parent and grandparent",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "MVUEt-2vt6yUkM8ztRO0q",
      "type": "text",
      "x": -2469.570558561055,
      "y": 13460.6633713965,
      "width": 25.25,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d22b2b",
      "fillStyle": "solid",
