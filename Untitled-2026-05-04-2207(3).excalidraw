      "labelPosition": null
    },
    {
      "id": "SqecxplxKKcyWYZ2HkbfT",
      "type": "text",
      "x": -549.3900634282754,
      "y": 27303.381476510953,
      "width": 304.5249938964844,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bdm",
      "roundness": null,
      "seed": 551741453,
      "version": 95,
      "versionNonce": 746313888,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789706895706,
      "created": 1789592612522,
      "link": null,
      "locked": false,
      "text": "4 types of fixes?",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4 types of fixes?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pjXcud9oCjLANBDlDJNOf",
      "type": "text",
      "x": -606.2332479513939,
      "y": 27381.679543303326,
      "width": 829.6749877929688,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d22b2b",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bdn",
      "roundness": null,
      "seed": 2090317987,
      "version": 748,
      "versionNonce": 750240928,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789706895706,
      "created": 1789592635983,
      "link": null,
      "locked": false,
      "text": "Again,\n\nWe ONLY have to consider cases where the tree was \nalready a valid red black tree. \n\nWe ONLY have to consider scenarios where insertion results \nin an invalid red black tree\n\nThe four cases we look at are the only configurations \nfulfilling those requirements",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Again,\n\nWe ONLY have to consider cases where the tree was \nalready a valid red black tree. \n\nWe ONLY have to consider scenarios where insertion results \nin an invalid red black tree\n\nThe four cases we look at are the only configurations \nfulfilling those requirements",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "cXkCrIvzU_WBa2kVDYGu9",
      "type": "text",
      "x": -495.80848554432384,
      "y": 27778.720811635325,
      "width": 252.3000030517578,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
