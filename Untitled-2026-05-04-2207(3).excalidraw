      "seed": 500704416,
      "version": 229,
      "versionNonce": 212905312,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789705216509,
      "created": 1789705197488,
      "link": null,
      "locked": false,
      "text": "Lemma?\nAny (n)-node BST can be transformed \ninto a right spine using right rotations.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lemma?\nAny (n)-node BST can be transformed \ninto a right spine using right rotations.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "crdIWraZHb4D7aDf75Sx3",
      "type": "text",
      "x": -1093.571096416995,
      "y": 3629.350575457363,
      "width": 942.4749755859375,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c07X",
      "roundness": null,
      "seed": 2094666080,
      "version": 31,
      "versionNonce": 1966735712,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789707163650,
      "created": 1789706959558,
      "link": null,
      "locked": false,
      "text": "Insertions Strategy:\n1. INSERTION: We insert our node and color it red \n2. FIXUP: Recolor and rotate nodes to fix violations",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Insertions Strategy:\n1. INSERTION: We insert our node and color it red \n2. FIXUP: Recolor and rotate nodes to fix violations",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "-A9OFy2Jqy1L8Dmfhx69T",
      "type": "text",
      "x": -1084.5059723488175,
      "y": 3807.3290061832795,
      "width": 1102,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c07Y",
      "roundness": null,
      "seed": 1682640032,
      "version": 604,
      "versionNonce": 2124139872,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789707433090,
      "created": 1789706990719,
      "link": null,
      "locked": false,
      "text": "let's consider what we must do to even insert onto a regular BST\n\nLet's review what a Binary Search Tree are trees that satisfy \nwhat is known as the:\n    - Binary search tree property - Let x be a node in a binary search tree. \n    If y is a node in the left subtree of x , then y: key <= x: key. \n    If y is a node in the right subtree of x , theny: key >= x: key.\n\nIn other words:\n    - all values in the left subtree of a node must be smaller  value of that node\n\n",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "let's consider what we must do to even insert onto a regular BST\n\nLet's review what a Binary Search Tree are trees that satisfy \nwhat is known as the:\n    - Binary search tree property - Let x be a node in a binary search tree. \n    If y is a node in the left subtree of x , then y: key <= x: key. \n    If y is a node in the right subtree of x , theny: key >= x: key.\n\nIn other words:\n    - all values in the left subtree of a node must be smaller  value of that node\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
