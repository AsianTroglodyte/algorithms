    {
      "id": "5HlzMUUcJBQaSIlappzEX",
      "type": "text",
      "x": -2380.5633612313245,
      "y": -8315.782869904226,
      "width": 942.4749755859375,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c07w",
      "roundness": null,
      "seed": 1780461728,
      "version": 393,
      "versionNonce": 995859616,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789799667143,
      "created": 1789707501246,
      "link": null,
      "locked": false,
      "text": "Insertions Strategy:\n1. INSERTION: We insert our node and color it red \n2. FIXUP: Recolor and rotate nodes to fix violations",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Insertions Strategy:\n1. INSERTION: We insert our node and color it red \n2. FIXUP: Recolor and rotate nodes to fix violations",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "7q7j67Ca4s6ZIeEela1Z9",
      "type": "text",
      "x": -970.6896512123637,
      "y": -12030.880196606686,
      "width": 1039.4749755859375,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c07x",
      "roundness": null,
      "seed": 941661344,
      "version": 1485,
      "versionNonce": 1392445600,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789799667143,
      "created": 1789707501246,
      "link": null,
      "locked": false,
      "text": "Let's review what a Binary Search Tree (BST) is. \n\nBSTs are trees that satisfy what is known as the:\n    - Binary search tree property - Let x be a node in a binary search tree. \n    If y is a node in the left subtree of x , then y: key <= x: key. \n    If y is a node in the right subtree of x , then y: key >= x: key.\n\nIn other words:\n    - all values in the left subtree of a node must be \n    smaller than or equal to that node\n    - all values in the right subtree of a node must \n    be greater than or equal to that node",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Let's review what a Binary Search Tree (BST) is. \n\nBSTs are trees that satisfy what is known as the:\n    - Binary search tree property - Let x be a node in a binary search tree. \n    If y is a node in the left subtree of x , then y: key <= x: key. \n    If y is a node in the right subtree of x , then y: key >= x: key.\n\nIn other words:\n    - all values in the left subtree of a node must be \n    smaller than or equal to that node\n    - all values in the right subtree of a node must \n    be greater than or equal to that node",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
