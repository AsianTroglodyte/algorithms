      "seed": 1417540768,
      "version": 695,
      "versionNonce": 1632523424,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1789797311069,
      "created": 1789753850625,
      "link": null,
      "locked": false,
      "text": "For the set  {1, 4, 5, 10, 16, 17, 21} of keys, draw \nbinary search trees of heights 2, 3, and 6.\n\nlet's start with height two what should be the root?\n\ndon't be afraid to guess and experiment!",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For the set  {1, 4, 5, 10, 16, 17, 21} of keys, draw \nbinary search trees of heights 2, 3, and 6.\n\nlet's start with height two what should be the root?\n\ndon't be afraid to guess and experiment!",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
