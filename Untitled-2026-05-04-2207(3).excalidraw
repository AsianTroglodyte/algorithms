    {
      "id": "3jmojZIG0ip78t8FhfSwj",
      "type": "text",
      "x": 2315.8498359184828,
      "y": -13380.04341309749,
      "width": 903.9249877929688,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0GR",
      "roundness": null,
      "seed": 840706400,
      "version": 519,
      "versionNonce": 658258080,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789799667143,
      "created": 1789795887286,
      "link": null,
      "locked": false,
      "text": "The height of a tree is defined as the total number of edges on \nthe longest downward path from the root node to a leaf node\n\nheight in a tree in general is about counting the edge\n\nheight(2) = 4\nheight(5) = 3\nheight(1) = 0",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The height of a tree is defined as the total number of edges on \nthe longest downward path from the root node to a leaf node\n\nheight in a tree in general is about counting the edge\n\nheight(2) = 4\nheight(5) = 3\nheight(1) = 0",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
