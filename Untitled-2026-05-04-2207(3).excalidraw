    },
    {
      "id": "FE5vfQIu8r8eHJRFyX8_d",
      "type": "text",
      "x": -2994.1679028998906,
      "y": 13786.867284802636,
      "width": 491.375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d22b2b",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDx",
      "roundness": null,
      "seed": 583142026,
      "version": 633,
      "versionNonce": 977574048,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789706917213,
      "created": 1789579921343,
      "link": null,
      "locked": false,
      "text": "properties\n 1. A node is either red of black.\n 2. the root is black\n 3. leaves (NIL) are black.\n 4. If a node is red, then its children are black.\n 5. All paths from a node to its NIL descendants \n    contain the same number of black nodes.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "properties\n 1. A node is either red of black.\n 2. the root is black\n 3. leaves (NIL) are black.\n 4. If a node is red, then its children are black.\n 5. All paths from a node to its NIL descendants \n    contain the same number of black nodes.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
