      "labelPosition": null
    },
    {
      "id": "P8ONbCuExVqneHVks-tdS",
      "type": "text",
      "x": -921.3855836620769,
      "y": 29223.241349695003,
      "width": 976.2999877929688,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bdu",
      "roundness": null,
      "seed": 2121078435,
      "version": 90,
      "versionNonce": 298261664,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789706895706,
      "created": 1789592811376,
      "link": null,
      "locked": false,
      "text": "Red-black trees guarantee:\n- Search: (O(log n))\n- Single insertion: (O(log n))\n- Single deletion: (O(log n))\n- Building or deleting an entire n-node tree: (O(n log n))\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Red-black trees guarantee:\n- Search: (O(log n))\n- Single insertion: (O(log n))\n- Single deletion: (O(log n))\n- Building or deleting an entire n-node tree: (O(n log n))\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "qU-T1A1Nh2wBCwTSbeclO",
      "type": "text",
      "x": -572.3039282648272,
      "y": 27846.21363227939,
      "width": 788.25,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bdv",
      "roundness": null,
      "seed": 1103956941,
      "version": 404,
      "versionNonce": 1341819040,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789706895706,
      "created": 1789592972555,
      "link": null,
      "locked": false,
      "text": "case 1: w is red\ncase 2: w is black, and both its children are black\ncase 3: w is black, left child is red and right child is black\ncase 4. w is black, and right child is red\n\nlike fixes for insertion, we may do more than one fix \nper invocation",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "case 1: w is red\ncase 2: w is black, and both its children are black\ncase 3: w is black, left child is red and right child is black\ncase 4. w is black, and right child is red\n\nlike fixes for insertion, we may do more than one fix \nper invocation",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
