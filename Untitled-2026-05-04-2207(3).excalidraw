    {
      "id": "ZQvdFqQEcUinht5eIXTOR",
      "type": "text",
      "x": -739.72375726378,
      "y": 8289.709726659894,
      "width": 489.6333312988281,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d22b2b",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6g",
      "roundness": null,
      "seed": 1238016778,
      "version": 457,
      "versionNonce": 1353673888,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789706917212,
      "created": 1789554207116,
      "link": null,
      "locked": false,
      "text": "properties\n 1. A node is either red of black.\n 2. the root is black\n 3. leaves (NIL) are black.\n 4. If a node is red, then its children are black.\n 5. All paths from a node to its NIL descendants \n    contain the same number of black nodes.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "properties\n 1. A node is either red of black.\n 2. the root is black\n 3. leaves (NIL) are black.\n 4. If a node is red, then its children are black.\n 5. All paths from a node to its NIL descendants \n    contain the same number of black nodes.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
