      "boundElements": null,
      "updated": 1789799667143,
      "created": 1789797408730,
      "link": null,
      "locked": false,
      "text": "Transplant",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Transplant",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "o1pD6FtiZnl-V3I8uJeDc",
      "type": "text",
      "x": 601.3768358024838,
      "y": -8819.599759414532,
      "width": 818.3881487165179,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0HQ",
      "roundness": null,
      "seed": 1708186976,
      "version": 916,
      "versionNonce": 792226976,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789799667143,
      "created": 1789797482326,
      "link": null,
      "locked": false,
      "text": "As part of deleting a node, subtrees need to move around\nwithin the binary search tree.\n\ntransplant replaces one subtree as a child of its parent\nwith another tree\n\nTransplant is a primitive operation for restructuring trees\n\nThey do not necessarily maintain the BST property. it is\nup to the callers of transplant function to maintain the \nBST property\n\nCLRS (the book) includes a transplant function because\nthe pointer fiddling is annoying enough to warrant an\nabstraction.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "As part of deleting a node, subtrees need to move around\nwithin the binary search tree.\n\ntransplant replaces one subtree as a child of its parent with another tree\n\nTransplant is a primitive operation for restructuring trees\n\nThey do not necessarily maintain the BST property. it is up to the callers of transplant function to maintain the \nBST property\n\nCLRS (the book) includes a transplant function because\nthe pointer fiddling is annoying enough to warrant an abstraction.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
