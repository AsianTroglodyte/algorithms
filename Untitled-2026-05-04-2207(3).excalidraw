    {
      "id": "g7pqK5nkhIYoJSHBj6GK6",
      "type": "text",
      "x": -1532.8904869318317,
      "y": 19758.20002026503,
      "width": 600.4249877929688,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "hachure",
