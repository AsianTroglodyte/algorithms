      "link": null,
      "locked": false,
      "text": "What is a Rotation?",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is a Rotation?",
